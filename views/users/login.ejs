<% layout("layouts/boilerplate") -%>
<section class="auth-page">
  <div class="auth-card">
    <p class="eyebrow">WELCOME BACK</p>
    <h1>Log in</h1>
    <p class="auth-subtitle">Pick up where your next trip begins.</p>
        <form action="/login" method="POST" class="needs-validation" novalidate>
            
            <div class="mb-3">
                <label for="username" class="form-label">Username or email:</label>
                <input 
                    type="text"
                    id="username"
                    name="username"
                    placeholder="Enter your username or email"
                    class="form-control"
                    autocomplete="username"
                    required
                >
            </div>

            <div class="mb-3">
                <label for="password" class="form-label">Password:</label>
                <div class="password-field">
                    <input
                        type="password"
                        id="password"
                        name="password"
                        placeholder="Add strong password"
                        class="form-control"
                        autocomplete="current-password"
                        required
                    >
                    <button
                        class="password-toggle"
                        type="button"
                        aria-label="Show password"
                        aria-controls="password"
                        aria-pressed="false"
                    >
                        <i class="fa-solid fa-eye" aria-hidden="true"></i>
                    </button>
                </div>
            </div>
                
            <button class="btn btn-brand w-100">Log in</button>
        </form>
    <p class="auth-switch">New to WanderLust? <a href="/signup">Create an account</a></p>
  </div>
</section>
