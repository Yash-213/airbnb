<% layout("layouts/boilerplate") -%>
<div class="row mt-3">
    <h1 class="col-6 offset-3">Signup on WonderLust</h1>
    <div class="col-6 offset-3">
        <form action="/signup" method="POST" class="needs-validation" novalidate>
            
            <div class="mb-3">
                <label for="username" class="form-label">Username:</label>
                <input 
                    type="text" 
                    id="username" 
                    name="username" 
                    placeholder="Add catchy username" 
                    class="form-control" 
                    required
                >
                <div class="valid-feedback">Username looks good!</div>
            </div>

            <div class="mb-3">
                <label for="email" class="form-label">Email:</label>
                <input 
                    type="email" 
                    id="email" 
                    name="email" 
                    placeholder="abc@gmail.com" 
                    class="form-control" 
                    required
                >
            </div>

            <div class="mb-3">
                <label for="password" class="form-label">Password:</label>
                <input 
                    type="password" 
                    id="password" 
                    name="password" 
                    placeholder="Add strong password" 
                    class="form-control" 
                    required
                >
            </div>
                
            <button class="btn btn-dark">Signup</button>
        </form>
    </div>
</div>
