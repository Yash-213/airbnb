<% layout('layouts/boilerplate') %>

<div class="container min-vh-100 d-flex align-items-center justify-content-center bg-light">
  <div class="text-center p-5 rounded-4 shadow-sm" style="background: #fff; max-width: 500px;">
    <div class="mb-4">
      <i class="bi bi-exclamation-circle text-danger" style="font-size: 4rem;"></i>
    </div>
    <h2 class="fw-bold mb-3" style="color: #FF385C;">Oops! Something went wrong.</h2>
    <p class="text-muted mb-4"><%= err.message || "An unexpected error occurred." %></p>

    <a href="/" class="btn btn-lg text-white rounded-pill" style="background-color: #FF385C;">
      <i class="bi bi-house-door"></i> Back to Home
    </a>

    <div class="mt-4 text-muted small">
      Error Code: <strong><%= err.statusCode || 500 %></strong>
    </div>
  </div>
</div>
